# ERADIS snapshot - the multi-valued facts of each current NoBo certificate, as
# (certificate, kind, value) rows:
#   manu     manufacturer organisation         (dct:contributor, Manufacturer role)
#   module   conformity assessment module      (dct:conformsTo, cld-modules only -
#            5,337 certificates also point at Decision 2010/713, the modules
#            decision itself, which is not a module)
#   tsi      TSI                               (eli:id_local)
#   dir      directive                         (dct:source)
#   title    interoperability constituent      (eli:title_short)
#   prev     number of an earlier version      (dct:replaces+, dct:identifier)
#   restr    1 when conditions / limits of use are recorded
PREFIX era:  <http://data.europa.eu/949/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX vpa:  <https://w3id.org/vpa#>
PREFIX eli:  <http://data.europa.eu/eli/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>

SELECT ?certificate ?kind ?value
WHERE {
	# Current version of each NoBo certificate (era:CertificationLevelDocument).
	# Only unpublished drafts are left out: a certificate whose only state is
	# "draft". The recorded state is otherwise a poor guide to validity (42,088
	# of the ~44,500 current certificates say "amended", 12 say "inForce"), so
	# validity is judged from the dct:valid window - see the explorer.
	GRAPH <http://data.europa.eu/949/graph/eradis> { ?certificate a era:CertificationLevelDocument }
	FILTER NOT EXISTS { ?certificate dct:isReplacedBy ?newer }
	FILTER EXISTS { ?certificate era:state ?publishedState
		FILTER(?publishedState != <http://data.europa.eu/949/concepts/evidence-document-states/draft>) }
	{ ?certificate dct:contributor ?m .
	  ?m era:hasOrganisationRole <http://data.europa.eu/949/concepts/organisation-roles/Manufacturer> ; era:roleOf ?value .
	  BIND("manu" AS ?kind) }
	UNION { ?certificate dct:conformsTo ?value .
	        FILTER(STRSTARTS(STR(?value), "http://data.europa.eu/949/concepts/cld-modules/"))
	        BIND("module" AS ?kind) }
	UNION { ?certificate eli:id_local ?value . BIND("tsi" AS ?kind) }
	UNION { ?certificate dct:source ?value . BIND("dir" AS ?kind) }
	UNION { ?certificate eli:title_short ?value . BIND("title" AS ?kind) }
	UNION { ?certificate dct:replaces+ ?old . ?old dct:identifier ?value .
	        FILTER NOT EXISTS { ?certificate dct:identifier ?value }
	        BIND("prev" AS ?kind) }
	UNION { FILTER EXISTS { ?certificate vpa:checkedCompliance/vpa:withRestriction/rdfs:comment ?r }
	        BIND("1" AS ?value) BIND("restr" AS ?kind) }
}
