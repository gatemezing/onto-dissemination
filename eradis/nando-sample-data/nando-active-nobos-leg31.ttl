    nando:hasNotification [ a nando:Notification ;
        dct:subject <https://example.org/nando/legislation/31> ;
        nando:notificationStatus <https://example.org/nando/notification-statuses/1> ] .
<https://example.org/nando/body/site/NB3093> a org:Site ;
