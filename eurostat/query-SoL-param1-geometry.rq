# query-SoL-param1-optimised.rq plus each section's own geometry
# (sectionofline_geometry, WKT, through era:netReference like the points).
# See that file for the measurements and the reasoning; this one only adds the
# column. It repeats a section's linestring on every track row: the whole EU
# grows from 71 MB to 137 MB, and takes 114 s as one request - too close to
# the endpoint's 120 s limit. Run it one country at a time, as the exporter
# does (DEU 26 s, FRA 29 s).
#
# Endpoint: https://graph.data.era.europa.eu/repositories/rinf-plus
# Generated by scripts/build-eurostat-queries.py - edit that, not this file.

PREFIX era:  <http://data.europa.eu/949/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

# Outer SELECT: every empty or missing value reads "no data"
SELECT
	?sectionofline
	?sectionofline_incountry
	(IF(COALESCE(?len_, "") != "", ?len_, "no data") AS ?sectionofline_lengthofsectionofline)
	(IF(COALESCE(STR(?trk), "") != "", STR(?trk), "no data") AS ?sectionofline_track)
	(IF(COALESCE(?imCode_, "") != "", ?imCode_, "no data") AS ?sectionofline_imcode)
	(IF(COALESCE(?line_, "") != "", ?line_, "no data") AS ?sectionofline_linenationalid_label)
	(IF(COALESCE(?solNature_, "") != "", ?solNature_, "no data") AS ?sectionofline_solnature)
	(IF(COALESCE(STR(?opStart_), "") != "", STR(?opStart_), "no data") AS ?sectionofline_opstart)
	(IF(COALESCE(?opStartName_, "") != "", ?opStartName_, "no data") AS ?sectionofline_opstart_opname)
	(IF(COALESCE(?opStartUopid_, "") != "", ?opStartUopid_, "no data") AS ?sectionofline_opstart_uopid)
	(IF(COALESCE(?opStartLoc_, "") != "", ?opStartLoc_, "no data") AS ?sectionofline_opstart_location)
	(IF(REGEX(COALESCE(?opStartLoc_, ""), "^\\s*POINT", "i"), REPLACE(?opStartLoc_, "^\\s*POINT\\s*\\(\\s*([^\\s)]+)\\s+([^\\s)]+).*$", "$2", "i"), "no data") AS ?sectionofline_opstart_location_lat)
	(IF(REGEX(COALESCE(?opStartLoc_, ""), "^\\s*POINT", "i"), REPLACE(?opStartLoc_, "^\\s*POINT\\s*\\(\\s*([^\\s)]+)\\s+([^\\s)]+).*$", "$1", "i"), "no data") AS ?sectionofline_opstart_location_lng)
	(IF(COALESCE(STR(?opEnd_), "") != "", STR(?opEnd_), "no data") AS ?sectionofline_opend)
	(IF(COALESCE(?opEndName_, "") != "", ?opEndName_, "no data") AS ?sectionofline_opend_opname)
	(IF(COALESCE(?opEndUopid_, "") != "", ?opEndUopid_, "no data") AS ?sectionofline_opend_uopid)
	(IF(COALESCE(?opEndLoc_, "") != "", ?opEndLoc_, "no data") AS ?sectionofline_opend_location)
	(IF(REGEX(COALESCE(?opEndLoc_, ""), "^\\s*POINT", "i"), REPLACE(?opEndLoc_, "^\\s*POINT\\s*\\(\\s*([^\\s)]+)\\s+([^\\s)]+).*$", "$2", "i"), "no data") AS ?sectionofline_opend_location_lat)
	(IF(REGEX(COALESCE(?opEndLoc_, ""), "^\\s*POINT", "i"), REPLACE(?opEndLoc_, "^\\s*POINT\\s*\\(\\s*([^\\s)]+)\\s+([^\\s)]+).*$", "$1", "i"), "no data") AS ?sectionofline_opend_location_lng)
	(IF(COALESCE(?validFrom_, "") != "", ?validFrom_, "no data") AS ?sectionofline_validitystartdate)
	(IF(COALESCE(?validTo_, "") != "", ?validTo_, "no data") AS ?sectionofline_validityenddate)
	(IF(COALESCE(?solGeom_, "") != "", ?solGeom_, "no data") AS ?sectionofline_geometry)
	(IF(COALESCE(?ten_, "") != "", ?ten_, "no data") AS ?sectionofline_track_tenclassification)
	(IF(COALESCE(?speed_, "") != "", ?speed_, "no data") AS ?sectionofline_track_maximumpermittedspeed)
	(IF(COALESCE(?freight_, "") != "", ?freight_, "no data") AS ?sectionofline_track_freightcorridor)
	(IF(COALESCE(?gauge_, "") != "", ?gauge_, "no data") AS ?sectionofline_track_wheelsetgauge)
	(IF(COALESCE(?cls_, "") != "", ?cls_, "no data") AS ?sectionofline_track_contactlinesystem)
	(IF(COALESCE(?clsType_, "") != "", ?clsType_, "no data") AS ?sectionofline_track_contactlinesystem_contactlinesystemtype)
	(IF(COALESCE(?energy_, "") != "", ?energy_, "no data") AS ?sectionofline_track_contactlinesystem_energysupplysystem)
	(IF(COALESCE(?etcs_, "") != "", ?etcs_, "no data") AS ?sectionofline_track_etcslevel_etcsleveltype)
	(IF(COALESCE(?gsmr_, "") != "", ?gsmr_, "no data") AS ?sectionofline_track_gsmrversion)
WHERE {
	{ SELECT ?sectionofline ?sectionofline_incountry ?trk
		(SAMPLE(?len) AS ?len_)
		(GROUP_CONCAT(DISTINCT ?imCode; SEPARATOR="|") AS ?imCode_)
		(GROUP_CONCAT(DISTINCT COALESCE(?lineId, ?lpsLabel); SEPARATOR="|") AS ?line_)
		(GROUP_CONCAT(DISTINCT COALESCE(?solNatureL, STR(?solNatureC)); SEPARATOR="|") AS ?solNature_)
		(GROUP_CONCAT(DISTINCT ?validFrom; SEPARATOR="|") AS ?validFrom_)
		(GROUP_CONCAT(DISTINCT ?validTo; SEPARATOR="|") AS ?validTo_)
		(GROUP_CONCAT(DISTINCT COALESCE(?tenClassL, STR(?tenClassC)); SEPARATOR="|") AS ?ten_)
		(GROUP_CONCAT(DISTINCT ?maxSpeed; SEPARATOR="|") AS ?speed_)
		(GROUP_CONCAT(DISTINCT COALESCE(?freightL, STR(?freightC)); SEPARATOR="|") AS ?freight_)
		(GROUP_CONCAT(DISTINCT COALESCE(?gaugeL, STR(?gaugeC)); SEPARATOR="|") AS ?gauge_)
		(GROUP_CONCAT(DISTINCT STR(?cls); SEPARATOR="|") AS ?cls_)
		(GROUP_CONCAT(DISTINCT COALESCE(?clsTypeL, STR(?clsTypeC)); SEPARATOR="|") AS ?clsType_)
		(GROUP_CONCAT(DISTINCT COALESCE(?energyL, STR(?energyC)); SEPARATOR="|") AS ?energy_)
		(GROUP_CONCAT(DISTINCT COALESCE(?etcsTypeL, STR(?etcsTypeC)); SEPARATOR="|") AS ?etcs_)
		(GROUP_CONCAT(DISTINCT COALESCE(?gsmrL, STR(?gsmrC)); SEPARATOR="|") AS ?gsmr_)
	WHERE {
		# The sections valid today, resolved first. DEU republishes every section a
		# year ahead (2026-01-01..2026-12-31 and again from 2027-01-01), which would
		# count every German section twice; sections with no dated validity (ten
		# countries publish none) are kept. Resolving them on their own lets GraphDB
		# run the validity test once per section, not once per joined row.
		{ SELECT ?sectionofline ?sectionofline_incountry WHERE {
			?sectionofline a era:SectionOfLine ;
				era:inCountry ?sectionofline_incountry .
			#FILTER(?sectionofline_incountry = <http://publications.europa.eu/resource/authority/country/FRA>)   # one country: uncomment
			BIND(xsd:date(SUBSTR(STR(NOW()), 1, 10)) AS ?today)
			FILTER NOT EXISTS { ?sectionofline era:validity/time:hasBeginning/time:inXSDDate ?vb FILTER(?vb > ?today) }
			FILTER NOT EXISTS { ?sectionofline era:validity/time:hasEnd/time:inXSDDate ?ve FILTER(?ve < ?today) }
		} }
		OPTIONAL { ?sectionofline era:lengthOfSectionOfLine ?len }
		# Concept-valued columns: the concept's English skos:prefLabel, or its URI
		# for the retired codes no vocabulary labels any more (see the header)
		OPTIONAL { ?sectionofline era:solNature ?solNatureC .
			OPTIONAL { ?solNatureC skos:prefLabel ?solNatureL FILTER(langMatches(lang(?solNatureL), "en")) } }
		OPTIONAL { ?sectionofline era:infrastructureManager/era:roleOf/era:organisationCode ?imCode }
		OPTIONAL {
			?sectionofline era:nationalLine ?lps .
			OPTIONAL { ?lps era:lineId ?lineId }
			# LPS labels are language-tagged: without this filter every language
			# variant becomes its own value
			OPTIONAL { ?lps rdfs:label ?lpsLabel FILTER(langMatches(lang(?lpsLabel), "en")) }
		}
		OPTIONAL {
			?sectionofline era:validity ?solValidity .
			OPTIONAL { ?solValidity time:hasBeginning/time:inXSDDate ?validFrom }
			OPTIONAL { ?solValidity time:hasEnd/time:inXSDDate ?validTo }
		}
		OPTIONAL {
			?sectionofline era:hasPart ?trk .
			OPTIONAL { ?trk era:tenClassification ?tenClassC .
				OPTIONAL { ?tenClassC skos:prefLabel ?tenClassL FILTER(langMatches(lang(?tenClassL), "en")) } }
			OPTIONAL { ?trk era:maximumPermittedSpeed ?maxSpeed }
			OPTIONAL { ?trk era:freightCorridor ?freightC .
				OPTIONAL { ?freightC skos:prefLabel ?freightL FILTER(langMatches(lang(?freightL), "en")) } }
			OPTIONAL { ?trk era:wheelSetGauge ?gaugeC .
				OPTIONAL { ?gaugeC skos:prefLabel ?gaugeL FILTER(langMatches(lang(?gaugeL), "en")) } }
			OPTIONAL {
				?trk era:contactLineSystem ?cls .
				OPTIONAL { ?cls era:contactLineSystemType ?clsTypeC .
					OPTIONAL { ?clsTypeC skos:prefLabel ?clsTypeL FILTER(langMatches(lang(?clsTypeL), "en")) } }
				OPTIONAL { ?cls era:energySupplySystem ?energyC .
					OPTIONAL { ?energyC skos:prefLabel ?energyL FILTER(langMatches(lang(?energyL), "en")) } }
			}
			OPTIONAL { ?trk era:etcs/era:etcsLevelType ?etcsTypeC .
				OPTIONAL { ?etcsTypeC skos:prefLabel ?etcsTypeL FILTER(langMatches(lang(?etcsTypeL), "en")) } }
			OPTIONAL { ?trk era:gsmRVersion ?gsmrC .
				OPTIONAL { ?gsmrC skos:prefLabel ?gsmrL FILTER(langMatches(lang(?gsmrL), "en")) } }
		}
	}
	GROUP BY ?sectionofline ?sectionofline_incountry ?trk }
	# the two operational points (and the section geometry), per section
	{ SELECT ?sectionofline
		(SAMPLE(?opStart) AS ?opStart_)
		(GROUP_CONCAT(DISTINCT ?opStartName; SEPARATOR="|") AS ?opStartName_)
		(GROUP_CONCAT(DISTINCT ?opStartUopid; SEPARATOR="|") AS ?opStartUopid_)
		(COALESCE(MIN(IF(STRSTARTS(UCASE(STR(?opStartW)), "POINT"), STR(?opStartW), ?notAPoint)), MIN(STR(?opStartW)), MIN(STR(?opStartDW))) AS ?opStartLoc_)
		(SAMPLE(?opEnd) AS ?opEnd_)
		(GROUP_CONCAT(DISTINCT ?opEndName; SEPARATOR="|") AS ?opEndName_)
		(GROUP_CONCAT(DISTINCT ?opEndUopid; SEPARATOR="|") AS ?opEndUopid_)
		(COALESCE(MIN(IF(STRSTARTS(UCASE(STR(?opEndW)), "POINT"), STR(?opEndW), ?notAPoint)), MIN(STR(?opEndW)), MIN(STR(?opEndDW))) AS ?opEndLoc_)
		(COALESCE(MIN(STR(?solW)), MIN(STR(?solDW))) AS ?solGeom_)
	WHERE {
		# The sections valid today, resolved first. DEU republishes every section a
		# year ahead (2026-01-01..2026-12-31 and again from 2027-01-01), which would
		# count every German section twice; sections with no dated validity (ten
		# countries publish none) are kept. Resolving them on their own lets GraphDB
		# run the validity test once per section, not once per joined row.
		{ SELECT ?sectionofline ?sectionofline_incountry WHERE {
			?sectionofline a era:SectionOfLine ;
				era:inCountry ?sectionofline_incountry .
			#FILTER(?sectionofline_incountry = <http://publications.europa.eu/resource/authority/country/FRA>)   # one country: uncomment
			BIND(xsd:date(SUBSTR(STR(NOW()), 1, 10)) AS ?today)
			FILTER NOT EXISTS { ?sectionofline era:validity/time:hasBeginning/time:inXSDDate ?vb FILTER(?vb > ?today) }
			FILTER NOT EXISTS { ?sectionofline era:validity/time:hasEnd/time:inXSDDate ?ve FILTER(?ve < ?today) }
		} }
		OPTIONAL {
			?sectionofline era:opStart ?opStart .
			OPTIONAL { ?opStart era:opName ?opStartName }
			OPTIONAL { ?opStart era:uopid ?opStartUopid }
			OPTIONAL { ?opStart era:netReference/geo:hasGeometry/geo:asWKT ?opStartW }
			OPTIONAL { ?opStart geo:hasGeometry/geo:asWKT ?opStartDW FILTER(!BOUND(?opStartW)) }
		}
		OPTIONAL {
			?sectionofline era:opEnd ?opEnd .
			OPTIONAL { ?opEnd era:opName ?opEndName }
			OPTIONAL { ?opEnd era:uopid ?opEndUopid }
			OPTIONAL { ?opEnd era:netReference/geo:hasGeometry/geo:asWKT ?opEndW }
			OPTIONAL { ?opEnd geo:hasGeometry/geo:asWKT ?opEndDW FILTER(!BOUND(?opEndW)) }
		}
		OPTIONAL { ?sectionofline era:netReference/geo:hasGeometry/geo:asWKT ?solW }
		OPTIONAL { ?sectionofline geo:hasGeometry/geo:asWKT ?solDW FILTER(!BOUND(?solW)) }
	}
	GROUP BY ?sectionofline }
}
