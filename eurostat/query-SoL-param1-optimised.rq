# Optimised version of query-SoL-param1.rq
#
# Endpoint: https://graph.data.era.europa.eu/repositories/rinf-plus
# Measured 2026-09-26 against the live RINF KG: all 30 columns, 129,508 rows,
# 92 MB CSV, ~60 s for the whole EU in one request.
#
# Performance: the joins were never the problem (~8 s). The cost was row
# multiplication and result size. Operational points carry several era:opName
# and era:uopid values (up to 16 for DEU) because the per-IM named graphs are
# queried as a union, and Austrian tracks carry up to 3 gauges x 3 contact-line
# systems x 6 ETCS levels, which multiply into a cartesian product. Aggregating
# every multi-valued field with GROUP_CONCAT and grouping at the real grain
# (section, track) cut AUT from 34,412 rows/90 s to 6,565 rows/5 s and brought
# the EU-wide query under the endpoint's 120 s limit. SELECT DISTINCT over 30
# wide columns was also removed - it cost ~60 s and de-duplicated nothing.
#
# Multi-valued fields are returned pipe-separated ("|"), e.g. an operational
# point renamed between publications gives "Technical change|BP SNCF Réseau LISEA".
#
# Re-measured 2026-09-28 after the two changes below: 111,089 rows, 62 MB CSV,
# ~78 s for the whole EU in one request (DEU ~17 s, FRA ~15-19 s, AUT ~7 s).
#
# CONCEPT LABELS. Every concept-valued column (solNature, tenClassification,
# freightCorridor, wheelSetGauge, contactLineSystemType, energySupplySystem,
# etcsLevelType, gsmRVersion) returns the concept's English skos:prefLabel -
# sol-natures/20 -> "Link", contact-line-systems/10 -> "Overhead contact line
# (OCL)" - instead of its URI. Each concept carries exactly one @en label, so
# the join cannot multiply rows. The URI is kept as a fallback because ten
# codes in active use are defined nowhere (not in rinf-plus, not in ERA-Onto):
# gsmr-versions/10, /20, /30, /40 (36,283 statements), etcs-levels/10 and /40
# (17,432), energy-supply-systems/90 and /N (856). A required
# ?x prop/skos:prefLabel ?l path would silently blank those cells; the URI
# instead makes the gap visible.
# The COALESCE sits inside GROUP_CONCAT, not in a BIND inside each OPTIONAL: a
# BIND in the OPTIONAL group makes GraphDB evaluate the group on its own, which
# measured AUT 14.7 s / DEU 40 s against 6.7 s / 26 s for identical output.
#
# VALIDITY. Only the description valid today is kept (FILTER NOT EXISTS on a
# beginning after today or an end before it; sections with no dated validity
# are kept). DEU republishes every section a year ahead - 2026-01-01..2026-12-31
# and again from 2027-01-01, open-ended - which doubled its rows (36,648 ->
# 18,313). The same rule also drops sections whose window has closed: on
# 2026-09-28 that is 37 Belgian sections ending 2026-09-06, 24 of them with no
# current replacement (mostly line 161 Brussels-Namur) - see
# sol-expired-validity-bel.rq/.csv.

#
# To go faster: run one country per request in parallel (uncomment the FILTER
# below). 28 countries at 6 concurrent requests completes in ~19-31 s. Germany
# alone is ~19 s and sets the floor; sharding it further does not help, because
# the cost is the join, not the transfer.
#
# Request with:
#   curl -X POST https://graph.data.era.europa.eu/repositories/rinf-plus \
#        -H "Accept: text/csv" --data-urlencode "query@query-SoL-param1-optimised.rq"
#   (CSV is far smaller than application/sparql-results+json; the endpoint does
#    not honour gzip.)

PREFIX era: <http://data.europa.eu/949/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>

SELECT
	?sectionofline
	?sectionofline_incountry
	?sectionofline_lengthofsectionofline
	?sectionofline_track
	(GROUP_CONCAT(DISTINCT ?imCode;       SEPARATOR="|") AS ?sectionofline_imcode)
	(GROUP_CONCAT(DISTINCT ?lineLabel;    SEPARATOR="|") AS ?sectionofline_linenationalid_label)
	(GROUP_CONCAT(DISTINCT COALESCE(?solNatureL, STR(?solNatureC));    SEPARATOR="|") AS ?sectionofline_solnature)
	(SAMPLE(?opStart)                                    AS ?sectionofline_opstart)
	(GROUP_CONCAT(DISTINCT ?opStartName;  SEPARATOR="|") AS ?sectionofline_opstart_opname)
	(GROUP_CONCAT(DISTINCT ?opStartUopid; SEPARATOR="|") AS ?sectionofline_opstart_uopid)
	(SAMPLE(?opStartLoc) AS ?sectionofline_opstart_location)
	(SAMPLE(?opStartLat) AS ?sectionofline_opstart_location_lat)
	(SAMPLE(?opStartLng) AS ?sectionofline_opstart_location_lng)
	(SAMPLE(?opEnd)                                      AS ?sectionofline_opend)
	(GROUP_CONCAT(DISTINCT ?opEndName;    SEPARATOR="|") AS ?sectionofline_opend_opname)
	(GROUP_CONCAT(DISTINCT ?opEndUopid;   SEPARATOR="|") AS ?sectionofline_opend_uopid)
	(SAMPLE(?opEndLoc) AS ?sectionofline_opend_location)
	(SAMPLE(?opEndLat) AS ?sectionofline_opend_location_lat)
	(SAMPLE(?opEndLng) AS ?sectionofline_opend_location_lng)
	(GROUP_CONCAT(DISTINCT ?validFrom;    SEPARATOR="|") AS ?sectionofline_validitystartdate)
	(GROUP_CONCAT(DISTINCT ?validTo;      SEPARATOR="|") AS ?sectionofline_validityenddate)
	(GROUP_CONCAT(DISTINCT COALESCE(?tenClassL, STR(?tenClassC));     SEPARATOR="|") AS ?sectionofline_track_tenclassification)
	(GROUP_CONCAT(DISTINCT ?maxSpeed;     SEPARATOR="|") AS ?sectionofline_track_maximumpermittedspeed)
	(GROUP_CONCAT(DISTINCT COALESCE(?freightL, STR(?freightC));      SEPARATOR="|") AS ?sectionofline_track_freightcorridor)
	(GROUP_CONCAT(DISTINCT COALESCE(?gaugeL, STR(?gaugeC));        SEPARATOR="|") AS ?sectionofline_track_wheelsetgauge)
	(GROUP_CONCAT(DISTINCT ?cls;          SEPARATOR="|") AS ?sectionofline_track_contactlinesystem)
	(GROUP_CONCAT(DISTINCT COALESCE(?clsTypeL, STR(?clsTypeC));      SEPARATOR="|") AS ?sectionofline_track_contactlinesystem_contactlinesystemtype)
	(GROUP_CONCAT(DISTINCT COALESCE(?energyL, STR(?energyC));       SEPARATOR="|") AS ?sectionofline_track_contactlinesystem_energysupplysystem)
	(GROUP_CONCAT(DISTINCT COALESCE(?etcsTypeL, STR(?etcsTypeC));     SEPARATOR="|") AS ?sectionofline_track_etcslevel_etcsleveltype)
	(GROUP_CONCAT(DISTINCT COALESCE(?gsmrL, STR(?gsmrC));         SEPARATOR="|") AS ?sectionofline_track_gsmrversion)

WHERE {
	?sectionofline a era:SectionOfLine ;
		era:inCountry ?sectionofline_incountry ;
		era:lengthOfSectionOfLine ?sectionofline_lengthofsectionofline .

	# Chunking: uncomment and run one country per request in parallel (~19-31 s for all 28).
	#FILTER(?sectionofline_incountry = <http://publications.europa.eu/resource/authority/country/FRA>)

	# Keep only the description valid today. DEU republishes every section for
	# the following year ahead of time (2026-01-01..2026-12-31 and again from
	# 2027-01-01, open-ended), which doubled its rows. Sections with no dated
	# validity (ten countries publish none) are kept.
	BIND(xsd:date(SUBSTR(STR(NOW()), 1, 10)) AS ?today)
	FILTER NOT EXISTS { ?sectionofline era:validity/time:hasBeginning/time:inXSDDate ?vb. FILTER(?vb > ?today) }
	FILTER NOT EXISTS { ?sectionofline era:validity/time:hasEnd/time:inXSDDate ?ve. FILTER(?ve < ?today) }

	# Concept-valued columns return the concept's English skos:prefLabel
	# (e.g. sol-natures/20 -> "Link"). See CONCEPT LABELS in query-SoL-param1-optimised.rq for
	# why the URI is kept as a fallback rather than dropped.
	OPTIONAL { ?sectionofline era:solNature ?solNatureC.
		OPTIONAL { ?solNatureC skos:prefLabel ?solNatureL. FILTER(langMatches(lang(?solNatureL), "en")) } }
	OPTIONAL { ?sectionofline era:infrastructureManager/era:roleOf/era:organisationCode ?imCode. }

	OPTIONAL {
		?sectionofline era:nationalLine ?lps.
		OPTIONAL { ?lps era:lineId ?lineId. }
		# LPS labels are language-tagged; without this filter every language
		# variant becomes its own group and multiplies the result.
		OPTIONAL { ?lps rdfs:label ?lpsLabel. FILTER(langMatches(lang(?lpsLabel), "en")) }
		BIND(COALESCE(?lineId, ?lpsLabel) AS ?lineLabel)
	}

	OPTIONAL {
		?sectionofline era:opStart ?opStart.
		OPTIONAL { ?opStart era:opName ?opStartName. }
		OPTIONAL { ?opStart era:uopid ?opStartUopid. }
		OPTIONAL { ?opStart geo:location ?opStartLoc.
			?opStartLoc geo:lat ?opStartLat ; geo:long ?opStartLng. }
	}
	OPTIONAL {
		?sectionofline era:opEnd ?opEnd.
		OPTIONAL { ?opEnd era:opName ?opEndName. }
		OPTIONAL { ?opEnd era:uopid ?opEndUopid. }
		OPTIONAL { ?opEnd geo:location ?opEndLoc.
			?opEndLoc geo:lat ?opEndLat ; geo:long ?opEndLng. }
	}

	OPTIONAL {
		?sectionofline era:validity ?solValidity.
		OPTIONAL { ?solValidity time:hasBeginning/time:inXSDDate ?validFrom. }
		OPTIONAL { ?solValidity time:hasEnd/time:inXSDDate ?validTo. }
	}

	OPTIONAL {
		?sectionofline era:hasPart ?sectionofline_track.
		OPTIONAL { ?sectionofline_track era:tenClassification ?tenClassC.
			OPTIONAL { ?tenClassC skos:prefLabel ?tenClassL. FILTER(langMatches(lang(?tenClassL), "en")) } }
		OPTIONAL { ?sectionofline_track era:maximumPermittedSpeed ?maxSpeed. }
		OPTIONAL { ?sectionofline_track era:freightCorridor ?freightC.
			OPTIONAL { ?freightC skos:prefLabel ?freightL. FILTER(langMatches(lang(?freightL), "en")) } }
		OPTIONAL { ?sectionofline_track era:wheelSetGauge ?gaugeC.
			OPTIONAL { ?gaugeC skos:prefLabel ?gaugeL. FILTER(langMatches(lang(?gaugeL), "en")) } }
		OPTIONAL {
			?sectionofline_track era:contactLineSystem ?cls.
			OPTIONAL { ?cls era:contactLineSystemType ?clsTypeC.
				OPTIONAL { ?clsTypeC skos:prefLabel ?clsTypeL. FILTER(langMatches(lang(?clsTypeL), "en")) } }
			OPTIONAL { ?cls era:energySupplySystem ?energyC.
				OPTIONAL { ?energyC skos:prefLabel ?energyL. FILTER(langMatches(lang(?energyL), "en")) } }
		}
		OPTIONAL { ?sectionofline_track era:etcs/era:etcsLevelType ?etcsTypeC.
			OPTIONAL { ?etcsTypeC skos:prefLabel ?etcsTypeL. FILTER(langMatches(lang(?etcsTypeL), "en")) } }
		OPTIONAL { ?sectionofline_track era:gsmRVersion ?gsmrC.
			OPTIONAL { ?gsmrC skos:prefLabel ?gsmrL. FILTER(langMatches(lang(?gsmrL), "en")) } }
	}
}
GROUP BY
	?sectionofline
	?sectionofline_incountry
	?sectionofline_lengthofsectionofline
	?sectionofline_track
