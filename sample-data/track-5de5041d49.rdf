	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="http://data.europa.eu/949/concepts/organisation-roles/OrgRoles"/>
	<skos:prefLabel xml:lang="en">Infrastructure Manager (IM)</skos:prefLabel>
	<skos:topConceptOf rdf:resource="http://data.europa.eu/949/concepts/organisation-roles/OrgRoles"/>
	<source xmlns="http://purl.org/dc/terms/" rdf:resource="http://data.europa.eu/eli/dir/2012/34/2019-01-01"/>
