# National lines for one country, keyed to the LinearPositioningSystem itself.
#
# Every infrastructure manager publishes national lines. Not all publish them
# the same way: 9,543 of the 9,642 era:LinearPositioningSystem resources in the
# endpoint carry era:lineId, and the 99 that do not are Croatia's 55 and
# Norway's 32, which put the identifier in the English rdfs:label instead
# ("NationalRailwayLine_M604", "B03-Kongsvingerbanen"). A query that asks only
# for era:lineId returns nothing at all for those two countries.
#
# So the identifier is taken from era:lineId where it exists and from the
# English label where it does not, and ?src records which. Note the label is
# language-tagged (en/hr/no) -- matching it as a plain literal never matches.
#
# The LPS URIs come back with each line so that every later query pins the
# resource with VALUES instead of matching an identifier string. That is both
# faster and safer: a line identifier is unique only within a Member State.
#
# Measured: HRV 55 lines (all by label), NOR 32 (all by label), ESP 466,
# DEU 1,482, FRA 895 -- all by era:lineId. 0.2-2.3 s.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX era:  <http://data.europa.eu/949/>
PREFIX eu:   <http://publications.europa.eu/resource/authority/country/>
SELECT ?line ?src (COUNT(DISTINCT ?sol) AS ?sections) (MIN(?kp) AS ?fromKm) (MAX(?kp) AS ?toKm)
       (GROUP_CONCAT(DISTINCT STR(?lps); separator=" ") AS ?lpsList)
WHERE {
  ?sol a era:SectionOfLine ; era:inCountry eu:HRV ; era:nationalLine ?lps .
  OPTIONAL { ?lps era:lineId ?lid }
  OPTIONAL { ?lps rdfs:label ?llabel FILTER(LANG(?llabel) = "en") }
  BIND(COALESCE(?lid, STR(?llabel)) AS ?line)
  FILTER(BOUND(?line))
  BIND(IF(BOUND(?lid), "lineId", "label") AS ?src)
  OPTIONAL { ?sol era:netReference/era:startsAt/era:hasLrsCoordinate/era:kmPost/era:kilometer ?kp }
}
GROUP BY ?line ?src ORDER BY ?line
