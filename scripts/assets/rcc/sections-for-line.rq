# Sections of a national line, with position and the latest validity window.
# Phase 1: resolved once and pinned into the parameter queries with VALUES.
#
# Two things make this query what it is.
#
# 1. It keys on the era:LinearPositioningSystem resource, not on a line
#    identifier string. A line identifier is unique only within a Member State,
#    and two managers publish no era:lineId at all (see lines-for-country.rq).
#
# 2. The newest validity window is chosen PER STRETCH of line, never line-wide.
#    Germany republishes the same stretch every year -- line 4000 carries 167
#    sections valid 2025 and another 167 valid 2026 over identical kilometres,
#    so unfiltered it comes back twice. France instead dates each section by the
#    day it opened: line 830000-1 spreads 25 beginnings across 702 sections, so
#    a line-wide maximum keeps 2 and deletes the rest -- reporting a tidy "132
#    rows" that looks like deduplication and is 99.6% data loss.
#
# Linear referencing is OPTIONAL because for one manager it is absent: Croatia's
# era:NetPointReference resources carry a geometry and no era:hasLrsCoordinate,
# so its sections have no kilometre position at all. They are reported without
# one rather than dropped.
#
# 0.45 s for DEU line 4000 (167 sections), 0.11 s for a Croatian line.
PREFIX era:  <http://data.europa.eu/949/>
PREFIX time: <http://www.w3.org/2006/time#>
SELECT DISTINCT ?sol ?startKp ?startOffset ?startPosition ?endPosition
WHERE {
  VALUES ?lps { <http://data.europa.eu/949/NationalRailwayLine_L101> }   # ... from lines-for-country.rq
  ?sol a era:SectionOfLine ; era:nationalLine ?lps .
  OPTIONAL { ?sol era:netReference/era:startsAt/era:hasLrsCoordinate
               [ era:kmPost/era:kilometer ?startKp ; era:offsetFromKilometricPost ?startOffset ] }
  OPTIONAL { ?sol era:netReference/era:endsAt/era:hasLrsCoordinate
               [ era:kmPost/era:kilometer ?endKp   ; era:offsetFromKilometricPost ?endOffset ] }
  BIND(IF(BOUND(?startKp), CONCAT(STR(?startKp), "+", STR(?startOffset)), "") AS ?startPosition)
  BIND(IF(BOUND(?endKp),   CONCAT(STR(?endKp),   "+", STR(?endOffset)),   "") AS ?endPosition)
  OPTIONAL { ?sol era:validity/time:hasBeginning/time:inXSDDate ?b }
  OPTIONAL { { SELECT ?startPosition ?endPosition (MAX(?bb) AS ?latest) WHERE {
      VALUES ?lps { <http://data.europa.eu/949/NationalRailwayLine_L101> }
      ?s2 a era:SectionOfLine ; era:nationalLine ?lps ;
          era:netReference/era:startsAt/era:hasLrsCoordinate
            [ era:kmPost/era:kilometer ?sk2 ; era:offsetFromKilometricPost ?so2 ] ;
          era:netReference/era:endsAt/era:hasLrsCoordinate
            [ era:kmPost/era:kilometer ?ek2 ; era:offsetFromKilometricPost ?eo2 ] ;
          era:validity/time:hasBeginning/time:inXSDDate ?bb .
      BIND(CONCAT(STR(?sk2), "+", STR(?so2)) AS ?startPosition)
      BIND(CONCAT(STR(?ek2), "+", STR(?eo2)) AS ?endPosition)
  } GROUP BY ?startPosition ?endPosition } }
  FILTER(!BOUND(?b) || !BOUND(?latest) || ?b = ?latest)
}
ORDER BY ?startKp ?startOffset
