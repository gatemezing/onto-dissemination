# RCC parameters along a line -- phase 2, pinned to sections resolved earlier.
#
# The single-query form (sections + parameters + validity in one) took 25 s for
# DEU line 4000 and 25 s for FRA 830000-1. Resolving the sections once with
# sections-for-line.rq and pinning them here with VALUES gives identical results
# in a fraction of that: the whole German run is 3.6 s, the French 6.6 s.
#
# The part-whole direction is chosen at run time rather than queried both ways.
# Every dataset publishes era:isPartOf except Croatia's, which publishes only
# era:hasPart -- but asking for both, whether by UNION or by an alternation
# path, takes this query from 1.4 s to 57 s, because the optimiser can no longer
# push the parameter join. A one-row probe decides which form to emit.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX era:  <http://data.europa.eu/949/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?sol ?trackName ?rinfIndex ?parameterLabel
       (GROUP_CONCAT(DISTINCT ?fullValue; separator=" | ") AS ?value)
WHERE {
  # The RCC parameter set, bound before any data is touched. Retired
  # (owl:deprecated) parameters are excluded: 4 of the 87 flagged properties.
  { SELECT DISTINCT ?parameter ?rinfIndex ?parameterLabel WHERE {
      ?parameter era:usedInRCCCalculations "true"^^xsd:boolean ;
                 era:rinfIndex ?rinfIndex ; rdfs:label ?parameterLabel .
      FILTER(LANG(?parameterLabel) = "" || LANGMATCHES(LANG(?parameterLabel), "en"))
      FILTER(STRSTARTS(?rinfIndex, "1.1"))
      FILTER NOT EXISTS { ?parameter owl:deprecated true }
  } }
  VALUES ?sol { <http://data.europa.eu/949/sectionOfLine/8cfa1fcc33> }   # ... from sections-for-line.rq
  ?track era:isPartOf ?sol .                                            # ... or ?sol era:hasPart ?track
  ?track rdfs:label ?trackName ; ?parameter ?value0 .
  OPTIONAL { ?value0 skos:prefLabel ?sk FILTER(LANG(?sk) = "en") }
  OPTIONAL { ?value0 rdfs:label ?lb }
  BIND(COALESCE(?sk, ?lb, ?value0) AS ?fullValue)
}
GROUP BY ?sol ?trackName ?rinfIndex ?parameterLabel
