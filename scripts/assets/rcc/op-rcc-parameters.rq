# RCC parameters at operational points -- phase 2, pinned to points resolved
# earlier by ops-for-line.rq.
#
# In the single-query form this exceeded the endpoint's 120 s limit for every
# country tried, returning HTTP 503. Split in two it is part of a 3.6 s run for
# DEU line 4000.
#
# France repeats tracks inside one operational point, so the newest track window
# is applied per point. The other duplication -- Germany republishing a whole
# station as separate resources sharing one era:uopid -- is handled in phase 1.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX era:  <http://data.europa.eu/949/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?op ?trackName ?rinfIndex ?parameterLabel
       (GROUP_CONCAT(DISTINCT ?fullValue; separator=" | ") AS ?value)
WHERE {
  { SELECT DISTINCT ?parameter ?rinfIndex ?parameterLabel WHERE {
      ?parameter era:usedInRCCCalculations "true"^^xsd:boolean ;
                 era:rinfIndex ?rinfIndex ; rdfs:label ?parameterLabel .
      FILTER(LANG(?parameterLabel) = "" || LANGMATCHES(LANG(?parameterLabel), "en"))
      FILTER(STRSTARTS(?rinfIndex, "1.2"))
      FILTER NOT EXISTS { ?parameter owl:deprecated true }
  } }
  VALUES ?op { <http://data.europa.eu/949/operationalPoint/0b13649bed> }   # ... from ops-for-line.rq
  ?track era:isPartOf ?op .                                               # ... or ?op era:hasPart ?track
  ?track rdfs:label ?trackName ; ?parameter ?value0 .
  VALUES ?type { era:RunningTrack era:Siding }
  ?track a ?type .
  OPTIONAL { ?track era:validity/time:hasBeginning/time:inXSDDate ?tb }
  OPTIONAL { { SELECT ?op (MAX(?bb) AS ?latest) WHERE {
      VALUES ?op { <http://data.europa.eu/949/operationalPoint/0b13649bed> }
      ?t2 era:isPartOf ?op ; era:validity/time:hasBeginning/time:inXSDDate ?bb } GROUP BY ?op } }
  FILTER(!BOUND(?tb) || !BOUND(?latest) || ?tb = ?latest)
  OPTIONAL { ?value0 skos:prefLabel ?sk FILTER(LANG(?sk) = "en") }
  OPTIONAL { ?value0 rdfs:label ?lb }
  BIND(COALESCE(?sk, ?lb, ?value0) AS ?fullValue)
}
GROUP BY ?op ?trackName ?rinfIndex ?parameterLabel
